# Azure Speech 자격증명은 저장소 밖 파일에서 참조한다.
# 대상 파일 형식 (KEY=VALUE):
#   AZURE_SPEECH_KEY=<키>
#   AZURE_SPEECH_REGION=koreacentral
#   DEEPSEEK_API_KEY=<키>          # 회의 정리(요약)용. 비우면 정리 버튼이 비활성화된다.
AZURE_CREDENTIALS_FILE=C:\path\to\translator_api.txt

# 자격증명 파일을 쓰지 않고 여기에 직접 넣어도 된다 (이쪽이 우선한다).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=koreacentral

# 회의 정리에 쓸 DeepSeek 모델. 비우면 deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# 회의방 접속 코드. 비워 두면 코드 없이 입장한다 (사내망 전용).
# 인터넷(터널)으로 열 때는 반드시 설정한다.
ROOM_PASSCODE=

# Floor (push-to-talk) limits, in seconds.
FLOOR_LIMIT_SECONDS=30
FLOOR_WARNING_SECONDS=25
